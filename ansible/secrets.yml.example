# Copy to secrets.yml (add secrets.yml to .gitignore — never commit real values)
# Get aws_access_key_id / aws_secret_access_key from: terraform output app_access_key_id
#                                                      terraform output -raw app_secret_access_key

aws_access_key_id: "PASTE_FROM_TERRAFORM_OUTPUT"
aws_secret_access_key: "PASTE_FROM_TERRAFORM_OUTPUT"
aws_region: "eu-north-1"

mongo_uri: "PASTE_YOUR_ATLAS_OR_DOCUMENTDB_CONNECTION_STRING"
jwt_secret: "any-random-long-string"
weather_api_key: "PASTE_IF_YOU_HAVE_ONE"
data_gov_api_key: "PASTE_IF_YOU_HAVE_ONE"
